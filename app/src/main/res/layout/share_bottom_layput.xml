<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    app:behavior_peekHeight="240dp"
    app:behavior_hideable = "true"
    android:background="@drawable/bottom_dialog_background"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:layout_marginTop="8dp"
        android:id="@+id/scrollPlaceId"
        android:layout_width="50dp"
        android:layout_height="4dp"
        android:background="@drawable/scroll_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
    </View>

    <LinearLayout
        android:id="@+id/BottomMainInfoLayoutId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/playlist_cover_card"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginVertical="8dp"
            android:layout_marginStart="13dp">

            <ImageView
                android:id="@+id/playlistImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playlist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/ys_text_regular"
                android:maxLines="1"
                tools:text = "Best Songs 2021"
                android:textColor="@color/theme_color"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tracks_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_text_regular"
                android:maxLines="1"
                android:textColor="@color/text_grey"
                android:textSize="11sp"
                tools:text="300 треков" />

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/shareBottomId"
        style="@style/SettingsTextStyle"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:text="Поделиться"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/BottomMainInfoLayoutId" />
    <TextView
        android:id="@+id/editBottomId"
        style="@style/SettingsTextStyle"
        android:layout_width="match_parent"
        android:paddingHorizontal="16dp"
        android:text="Редактировать информацию"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shareBottomId" />
    <TextView
        android:id="@+id/deleteBottomId"
        style="@style/SettingsTextStyle"
        android:layout_width="match_parent"
        android:paddingHorizontal="16dp"
        android:text="Удалить плейлист"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editBottomId" />

</androidx.constraintlayout.widget.ConstraintLayout>